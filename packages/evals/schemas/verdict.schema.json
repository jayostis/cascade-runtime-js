{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayostis/cascade-runtime-js/packages/evals/schemas/verdict.schema.json",
  "title": "A judge's verdict",
  "description": "One grade per blinded answer to one question, by its label: every key item of that question found, partly or missed (a fact, absence, negation or gap) or raised or avoided (a trap or near-trap), every point of the answer beyond the key with its verdict, and each point's chain.",
  "type": "object",
  "required": ["outputs"],
  "additionalProperties": false,
  "properties": {
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "items", "beyond", "chains"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "verdict", "items", "reason"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "verdict": {
                  "enum": ["found", "partly", "missed", "raised", "avoided"]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "beyond": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item", "verdict", "why"],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "integer",
                  "minimum": 1
                },
                "verdict": {
                  "enum": [
                    "fair",
                    "true-not-planted",
                    "speculative",
                    "contradicted"
                  ]
                },
                "why": {
                  "type": "string"
                }
              }
            }
          },
          "chains": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item", "complete", "faithful", "skipped"],
              "additionalProperties": false,
              "properties": {
                "complete": {
                  "type": "boolean"
                },
                "faithful": {
                  "type": "boolean"
                },
                "skipped": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "item": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
