{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayostis/cascade-runtime-js/packages/evals/schemas/results.schema.json",
  "title": "An eval run's results",
  "description": "Everything one run did, machine-readable, and the only source the report site is built from. A run driven from Claude Code fills each model call from the agent's transcript (usageSource transcript); a runner on the Claude API fills the same fields from each response's usage (usageSource api). Tokens are the API's: input (uncached), cacheCreation, cacheRead and output; total is all four.",
  "type": "object",
  "required": [
    "schema",
    "run",
    "versions",
    "budget",
    "cases",
    "jobs",
    "asked",
    "toolCalls",
    "checks",
    "judgeDiscipline",
    "answers",
    "evidence",
    "grades",
    "instances",
    "agreement"
  ],
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "money": {
      "type": "number",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "cite": {
      "oneOf": [
        {
          "type": "object",
          "required": ["file", "line"],
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": ["file", "resource"],
          "properties": {
            "file": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["entry"],
          "properties": {
            "entry": {
              "type": "string"
            }
          }
        }
      ]
    },
    "tokens": {
      "type": "object",
      "required": ["input", "cacheCreation", "cacheRead", "output", "total"],
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/count"
        },
        "cacheCreation": {
          "$ref": "#/$defs/count"
        },
        "cacheRead": {
          "$ref": "#/$defs/count"
        },
        "output": {
          "$ref": "#/$defs/count"
        },
        "total": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "call": {
      "type": "object",
      "description": "One model call.",
      "required": [
        "at",
        "model",
        "input",
        "cacheCreation",
        "cacheRead",
        "output",
        "toolCalls",
        "usd"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/count"
        },
        "cacheCreation": {
          "$ref": "#/$defs/count"
        },
        "cacheRead": {
          "$ref": "#/$defs/count"
        },
        "output": {
          "$ref": "#/$defs/count"
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "calls",
        "models",
        "tokens",
        "contextPeak",
        "toolCalls",
        "wallSeconds",
        "cost",
        "usageSource"
      ],
      "additionalProperties": false,
      "properties": {
        "calls": {
          "$ref": "#/$defs/count"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "contextPeak": {
          "$ref": "#/$defs/count"
        },
        "toolCalls": {
          "type": "object",
          "required": ["total", "byName"],
          "additionalProperties": false,
          "properties": {
            "total": {
              "$ref": "#/$defs/count"
            },
            "byName": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/count"
              }
            }
          }
        },
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "cost": {
          "type": "object",
          "required": ["usd", "basis", "priceTable"],
          "additionalProperties": false,
          "properties": {
            "usd": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "basis": {
              "enum": ["exact", "estimated"]
            },
            "priceTable": {
              "type": "string"
            }
          }
        },
        "usageSource": {
          "enum": ["api", "transcript", "agent-total"]
        }
      }
    },
    "estimate": {
      "type": "object",
      "required": ["tokens", "usd"],
      "properties": {
        "tokens": {
          "$ref": "#/$defs/count"
        },
        "usd": {
          "$ref": "#/$defs/money"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "part": {
      "type": "object",
      "required": ["calls", "tokens", "usd", "seconds"],
      "additionalProperties": false,
      "description": "A share of a session: its calls, their tokens and price, and its wall time.",
      "properties": {
        "calls": {
          "$ref": "#/$defs/count"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "recordsContext": {
          "$ref": "#/$defs/count",
          "description": "The grab bag's shared part: the context its files added."
        },
        "recordsTokens": {
          "$ref": "#/$defs/count",
          "description": "The grab bag's question: its files re-read as cache, the records context times its calls."
        }
      }
    },
    "verdicts": {
      "type": "object",
      "required": ["of", "split", "ungraded"],
      "additionalProperties": {
        "$ref": "#/$defs/count"
      },
      "properties": {
        "of": {
          "$ref": "#/$defs/count"
        },
        "split": {
          "$ref": "#/$defs/count"
        },
        "ungraded": {
          "$ref": "#/$defs/count"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "cascade-evals/results/2"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "tier",
        "runner",
        "created",
        "finished",
        "wallSeconds",
        "stoppedAtCap",
        "config",
        "configSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "tier": {
          "enum": ["smoke", "standard", "full", "custom"]
        },
        "runner": {
          "enum": ["claude-code", "api"]
        },
        "created": {
          "type": "string"
        },
        "finished": {
          "type": "string"
        },
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "stoppedAtCap": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        },
        "configSha256": {
          "type": "string"
        }
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "harness",
        "podPackages",
        "components",
        "prompts",
        "priceTable"
      ],
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "object",
          "required": ["commit", "uncommitted"],
          "properties": {
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "uncommitted": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "podPackages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "repository", "commit", "source"],
            "properties": {
              "name": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              },
              "commit": {
                "$ref": "#/$defs/commit"
              },
              "source": {
                "type": "string"
              },
              "uncommitted": {
                "$ref": "#/$defs/count"
              }
            }
          }
        },
        "prompts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "priceTable": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["cap", "estimate", "spent", "byRole"],
      "additionalProperties": false,
      "properties": {
        "cap": {
          "type": "object",
          "properties": {
            "tokens": {
              "$ref": "#/$defs/count"
            },
            "usd": {
              "$ref": "#/$defs/money"
            }
          }
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        },
        "spent": {
          "type": "object",
          "required": ["tokens", "usd", "basis"],
          "properties": {
            "tokens": {
              "$ref": "#/$defs/count"
            },
            "usd": {
              "$ref": "#/$defs/money"
            },
            "basis": {
              "enum": ["exact", "estimated"]
            }
          }
        },
        "byRole": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["tokens", "usd"],
            "properties": {
              "tokens": {
                "$ref": "#/$defs/count"
              },
              "usd": {
                "$ref": "#/$defs/money"
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "downloadsSha256",
          "keySha256",
          "imports",
          "documents",
          "sessions",
          "key",
          "keyUrl",
          "build"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "downloadsSha256": {
            "type": "string"
          },
          "keySha256": {
            "type": "string"
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["download", "records"],
              "properties": {
                "download": {
                  "type": "string"
                },
                "records": {
                  "$ref": "#/$defs/count"
                },
                "refused": {
                  "type": "string"
                }
              }
            }
          },
          "documents": {
            "type": "array",
            "description": "The records arm's documents in reading order, with their sizes.",
            "items": {
              "type": "object",
              "required": ["file", "bytes"],
              "properties": {
                "file": {
                  "type": "string"
                },
                "bytes": {
                  "$ref": "#/$defs/count"
                }
              }
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "questions"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "asks"],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "asks": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "key": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "question",
                "kind",
                "title",
                "lookingFor",
                "pod"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "lookingFor": {
                  "type": "string"
                },
                "pod": {
                  "enum": ["visible", "deeper", "narrative-only"]
                }
              }
            }
          },
          "keyUrl": {
            "type": "string"
          },
          "build": {
            "type": ["object", "null"],
            "description": "The pod's build: once per person, outside every answer's cost.",
            "required": ["seconds", "modelCalls", "tokens", "usd"],
            "additionalProperties": false,
            "properties": {
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "modelCalls": {
                "$ref": "#/$defs/count"
              },
              "tokens": {
                "$ref": "#/$defs/count"
              },
              "usd": {
                "$ref": "#/$defs/money"
              }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "model", "tag", "status", "estimate"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": ["subject", "judge", "harness"]
          },
          "case": {
            "type": "string"
          },
          "arm": {
            "enum": ["pod", "records"]
          },
          "model": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "tag": {
            "type": "string"
          },
          "inputsHash": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "dispatched",
              "running",
              "done",
              "reused",
              "skipped",
              "failed"
            ]
          },
          "reason": {
            "type": "string"
          },
          "reusedFrom": {
            "type": "string"
          },
          "estimate": {
            "$ref": "#/$defs/estimate"
          },
          "stats": {
            "$ref": "#/$defs/stats"
          },
          "calls": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/call"
            }
          },
          "prompt": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "description": "A judge's letters: each the answer to one question of one subject job.",
            "additionalProperties": {
              "type": "object",
              "required": ["job", "question"],
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                }
              }
            }
          },
          "dispatched": {
            "type": "boolean"
          },
          "toolUses": {
            "type": "array",
            "description": "The tools the agent used, from its transcript (a written file's content left out).",
            "items": {
              "type": "object",
              "required": ["name", "input"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "input": {
                  "type": "object"
                }
              }
            }
          },
          "workdir": {
            "type": "string"
          },
          "packet": {
            "type": "string"
          },
          "packetSha256": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answers": {
            "type": "string",
            "description": "The folder of a session's answers, one file per question."
          },
          "split": {
            "type": "object",
            "required": ["shared", "questions"],
            "additionalProperties": false,
            "description": "A session's cost: the part before its first question (the prompt; for the grab bag, reading its files), then each question's.",
            "properties": {
              "shared": {
                "$ref": "#/$defs/part"
              },
              "questions": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/part"
                }
              }
            }
          }
        }
      }
    },
    "toolCalls": {
      "type": "array",
      "description": "Every pod-arm tool call: its input, and the rows and entries it returned.",
      "items": {
        "type": "object",
        "required": [
          "job",
          "at",
          "tool",
          "input",
          "ok",
          "rows",
          "entries",
          "milliseconds"
        ],
        "additionalProperties": false,
        "properties": {
          "job": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "rows": {
            "$ref": "#/$defs/count"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "milliseconds": {
            "$ref": "#/$defs/count"
          },
          "answer": {
            "type": "string",
            "description": "The answer's text, which absences are checked against."
          },
          "call": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "description": "By subject job, then question.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "answerValid",
            "answerErrors",
            "citations",
            "absences",
            "trapWording",
            "discipline"
          ],
          "additionalProperties": false,
          "properties": {
            "answerValid": {
              "type": "boolean"
            },
            "answerErrors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["item", "fact", "cite", "ok"],
                "properties": {
                  "fact": {
                    "type": "integer"
                  },
                  "cite": {
                    "$ref": "#/$defs/cite"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "missing": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "foundAt": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "excerpt": {
                    "type": "string"
                  },
                  "shows": {
                    "type": "string"
                  },
                  "item": {
                    "type": "integer"
                  }
                }
              }
            },
            "absences": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["item", "absence", "backed"],
                "properties": {
                  "absence": {
                    "type": "integer"
                  },
                  "backed": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "item": {
                    "type": "integer"
                  }
                }
              }
            },
            "trapWording": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "item", "pattern", "means", "text"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "item": {
                    "type": "integer"
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "means": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "discipline": {
              "type": "object",
              "required": ["ok", "violations"],
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "violations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "answers": {
      "type": "object",
      "description": "By subject job, then question.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "question",
          "judge",
          "items",
          "beyond",
          "chains"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "judge": {
            "type": "string"
          },
          "items": {
            "type": "array"
          },
          "beyond": {
            "type": "array"
          },
          "chains": {
            "type": "array"
          }
        }
      }
    },
    "agreement": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance", "judges", "items", "agreed", "kappa"],
        "properties": {
          "judges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "$ref": "#/$defs/count"
          },
          "agreed": {
            "$ref": "#/$defs/count"
          },
          "kappa": {
            "type": ["number", "null"]
          },
          "instance": {
            "type": "string"
          }
        }
      }
    },
    "judgeDiscipline": {
      "type": "object",
      "description": "Each judge's tools beyond reading its packet and writing its verdict, by job id.",
      "additionalProperties": {
        "type": "object",
        "required": ["ok", "violations"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "asked": {
      "type": "array",
      "description": "Each question as it was handed out in its session, in the person's words.",
      "items": {
        "type": "object",
        "required": ["job", "question", "at", "message"],
        "additionalProperties": false,
        "properties": {
          "job": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Each citation and absence resolved mechanically: a pod entry to its member records, revisions and source documents; a file to its passage and download; an absence to the call or files behind it.",
      "items": {
        "type": "object",
        "required": ["job", "question", "item"],
        "additionalProperties": false,
        "properties": {
          "job": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "item": {
            "type": "integer"
          },
          "fact": {
            "type": "integer"
          },
          "absence": {
