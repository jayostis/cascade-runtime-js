{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayostis/cascade-runtime-js/packages/evals/schemas/answer.schema.json",
  "title": "A subject's answer",
  "description": "Up to ten questions for the doctor, most important first. Each is a chain: the facts the records state (each cited), what the records lack (each with what was looked through, and for the pod the query that looked), the model's own medical knowledge that links them, and the question.",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "$defs": {
    "cite": {
      "oneOf": [
        {
          "type": "object",
          "required": ["file", "line"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["file", "resource"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "resource": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["entry"],
          "additionalProperties": false,
          "properties": { "entry": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  },
  "properties": {
    "questions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "n",
          "question",
          "why",
          "confidence",
          "facts",
          "absences",
          "knowledge"
        ],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "question": { "type": "string", "minLength": 1 },
          "why": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["says", "provider", "cite"],
              "additionalProperties": false,
              "properties": {
                "says": { "type": "string" },
                "provider": { "type": "string" },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "values": { "type": "array", "items": { "type": "string" } },
                "cite": { "$ref": "#/$defs/cite" }
              }
            }
          },
          "absences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["what", "coverage"],
              "additionalProperties": false,
              "properties": {
                "what": { "type": "string" },
                "coverage": { "type": "string" },
                "query": {
                  "type": "object",
                  "required": ["tool", "input"],
                  "additionalProperties": false,
                  "properties": {
                    "tool": { "type": "string" },
                    "input": { "type": "object" }
                  }
                }
              }
            }
          },
          "knowledge": {
            "type": "object",
            "required": ["says"],
            "additionalProperties": false,
            "properties": {
              "says": { "type": "string" },
              "guideline": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
