{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayostis/cascade-runtime-js/packages/evals/schemas/case.schema.json",
  "title": "An eval case",
  "description": "A synthetic person, a 'today', the downloads made for them (the vocabulary kit's copies plus a generator's), the order a pod imports them in and the order the records arm reads them in, and the description a report shows. Only synthetic people: `synthetic` must be true.",
  "type": "object",
  "required": [
    "id",
    "synthetic",
    "person",
    "today",
    "description",
    "downloads",
    "imports",
    "reading"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "synthetic": {
      "const": true,
      "description": "A made-up person. The harness refuses any case that is not."
    },
    "person": {
      "type": "object",
      "required": ["name", "pronoun"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "pronoun": { "enum": ["her", "his", "their"] }
      }
    },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": {
      "type": "object",
      "required": [
        "summary",
        "who",
        "sources",
        "planted",
        "traps",
        "guidelines",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "who": { "type": "string" },
        "sources": { "type": "string" },
        "planted": { "type": "string" },
        "traps": { "type": "string" },
        "guidelines": { "type": "array", "items": { "type": "string" } },
        "from": { "type": "string" }
      }
    },
    "downloads": {
      "type": "object",
      "required": ["kit", "generate", "sha256"],
      "additionalProperties": false,
      "properties": {
        "kit": {
          "type": "array",
          "description": "Files or folders copied from the vocabulary the runtime resolves.",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        },
        "uses": {
          "type": "array",
          "description": "Other cases whose downloads the generator reads; its second argument is the first one's folder.",
          "items": {
            "type": "object",
            "required": ["case"],
            "additionalProperties": false,
            "properties": { "case": { "type": "string" } }
          }
        },
        "generate": {
          "type": "string",
          "description": "The generator, run as `node <it> <downloads> [<used case's downloads>]`."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The downloads the key was written against: SHA-256 of the lines '<file's sha256>  <path>\\n', sorted by path."
        }
      }
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "What the pod imports, in download order."
    },
    "reading": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "The files the records arm reads, in order."
    }
  }
}
