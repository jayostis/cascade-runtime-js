{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jayostis/cascade-runtime-js/packages/evals/schemas/key.schema.json",
  "title": "A case's key, machine-readable half",
  "description": "One item per planted gap, trap or near-trap: the evidence it rests on (each a claim the citation checker verifies against the case's downloads), the links the reasoning must state, and what counts as found, partly found or wrong. Written before any run; the prose half (key.md) gives the rationale and the guidelines.",
  "type": "object",
  "required": ["case", "written", "items"],
  "additionalProperties": false,
  "$defs": {
    "cite": {
      "oneOf": [
        {
          "type": "object",
          "required": ["file", "line"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["file", "resource"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "resource": { "type": "string", "pattern": "^[A-Za-z]+/[^/]+$" }
          }
        },
        {
          "type": "object",
          "required": ["entry"],
          "additionalProperties": false,
          "properties": { "entry": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "claim": {
      "type": "object",
      "required": ["cite"],
      "additionalProperties": false,
      "properties": {
        "cite": { "$ref": "#/$defs/cite" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "says": {
          "type": "string",
          "description": "What the record says, in words, for a page to show."
        }
      }
    },
    "find": {
      "type": "object",
      "description": "Rows of a pod question that hold the item's entries, for its graph slice: every row whose values contain each `where` text.",
      "required": ["question"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string" },
        "where": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "case": { "type": "string" },
    "written": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "lookingFor",
          "evidence",
          "links",
          "found",
          "wrong",
          "pod"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
          "kind": { "enum": ["gap", "trap", "near-trap"] },
          "title": { "type": "string" },
          "lookingFor": {
            "type": "string",
            "description": "One line a reader scans: what an answer is looked at for."
          },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
          "absent": {
            "type": "array",
            "items": { "type": "string" },
            "description": "What the item says is not in the records, and where it was looked for."
          },
          "links": {
            "type": "array",
            "items": { "type": "string" },
            "description": "The reasoning's steps from the facts to the question: the medical knowledge the chain needs."
          },
          "found": { "type": "string" },
          "partly": { "type": "string" },
          "wrong": { "type": "array", "items": { "type": "string" } },
          "notWrong": { "type": "array", "items": { "type": "string" } },
          "wording": {
            "type": "array",
            "description": "Trap wording a program flags: a regular expression (case-insensitive) and what a match means.",
            "items": {
              "type": "object",
              "required": ["pattern", "means"],
              "additionalProperties": false,
              "properties": {
                "pattern": { "type": "string" },
                "means": { "type": "string" }
              }
            }
          },
          "pod": {
            "enum": ["visible", "deeper", "narrative-only"],
            "description": "Where the pod holds the item's facts: in a first answer, one question deeper, or nowhere (narrative the pod does not carry)."
          },
          "guideline": { "type": "string" },
          "find": { "type": "array", "items": { "$ref": "#/$defs/find" } }
        }
      }
    },
    "preExisting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "says"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "says": { "type": "string" },
          "legitimateFind": { "type": "boolean" }
        }
      }
    },
    "generic": { "type": "array", "items": { "type": "string" } }
  }
}
