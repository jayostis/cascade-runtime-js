{
  "name": "cascade-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What an app imports: a pod it opens, looks into an export with, imports, enters, judges, matches and asks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayostis/cascade-runtime-js.git",
    "directory": "packages/cascade-runtime"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/src/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./check": {
      "browser": {
        "types": "./dist/src/check.d.ts",
        "default": "./dist/browser/check.js"
      },
      "types": "./dist/src/check.d.ts",
      "default": "./dist/src/check.js"
    },
    "./package.json": "./package.json",
    "./vite": {
      "types": "./dist/src/node/vite.d.ts",
      "default": "./dist/src/node/vite.js"
    },
    "./fixtures": {
      "types": "./dist/src/fixtures.d.ts",
      "default": "./dist/src/fixtures.js"
    },
    "./published": {
      "types": "./dist/src/node/published.d.ts",
      "default": "./dist/src/node/published.js"
    }
  },
  "files": [
    "dist/src",
    "dist/browser",
    "README.md",
    "guide/AGENTS.md"
  ],
  "dependencies": {
    "@cascade-runtime/fhir-pull": "0.0.0",
    "@cascade-runtime/runtime": "0.0.0",
    "oxigraph": "0.5.11"
  },
  "peerDependencies": {
    "vite": "^8.3.3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@the-cascade-protocol/sandbox": "github:jayostis/cascade-sandbox#a33529e58830cb8b9c04f9c19c9e666f45634e3c",
    "esbuild": "0.28.2",
    "vite": "8.3.3"
  }
}
