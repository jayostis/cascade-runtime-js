{
  "name": "cascade-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An MCP server on stdio over a folder of Cascade pods: the read-only tools of cascade-runtime/tools.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cascade-mcp": "dist/src/cli.js"
