      "default": "./dist/src/server.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "cascade-runtime": "0.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
