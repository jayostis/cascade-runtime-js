{
  "name": "cascade-runtime-js",
  "private": true,
  "type": "module",
  "description": "The reference implementation of cascade-vocabulary's runtime rules.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/runtime",
    "packages/apple-health",
    "packages/ccda-download",
    "packages/demo-hospital",
    "packages/site",
    "packages/graphdb",
    "packages/cascade-runtime"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b && node --test \"packages/*/dist/test/**/*.test.js\"",
    "test:browser": "tsc -b && node --test packages/site/dist/test-browser/try.test.js",
    "test:live": "tsc -b && node --test packages/site/dist/test-browser/live.test.js",
    "test:launcher": "tsc -b && node --test packages/cascade-runtime/dist/test-launcher/launcher.test.js",
    "conformance": "tsc -b && node packages/runtime/dist/src/node/cli.js conformance",
    "build:example-pod": "tsc -b && node packages/runtime/dist/src/node/cli.js build-example-pod",
    "build:example-site": "tsc -b && node packages/site/dist/src/node/cli.js build-example-site",
    "build:example": "tsc -b && node packages/site/dist/src/node/cli.js build-example",
    "build:pages": "tsc -b && node packages/site/dist/src/node/cli.js build-pages",
    "build:package": "tsc -b && node packages/cascade-runtime/dist/pack/pack.js",
    "serve:pages": "tsc -b && node packages/site/dist/src/node/cli.js serve-pages",
    "ask": "tsc -b && node packages/site/dist/src/node/cli.js ask",
    "graphdb": "tsc -b && node packages/graphdb/dist/src/node/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
