{
  "name": "cascade-runtime-js",
  "private": true,
  "type": "module",
  "description": "The reference implementation of cascade-vocabulary's runtime rules.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/runtime",
    "packages/apple-health",
    "packages/site",
    "packages/graphdb"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b && node --test \"packages/*/dist/test/**/*.test.js\"",
    "conformance": "tsc -b && node packages/runtime/dist/src/node/cli.js conformance",
    "build:example-pod": "tsc -b && node packages/runtime/dist/src/node/cli.js build-example-pod"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
