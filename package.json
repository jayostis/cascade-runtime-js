{
  "name": "cascade-runtime-js",
  "private": true,
  "type": "module",
  "description": "The reference implementation of cascade-vocabulary's runtime rules.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/runtime",
    "packages/apple-health",
    "packages/ccda-download",
    "packages/fhir-pull",
    "packages/site",
    "packages/graphdb",
    "packages/cascade-runtime",
    "packages/mcp",
    "packages/evals"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/transpile.mjs && node scripts/test.mjs",
    "transpile": "node scripts/transpile.mjs",
    "test:live": "tsc -b && node --test packages/site/dist/test-browser/live.test.js",
    "test:launcher": "tsc -b && node --test packages/cascade-runtime/dist/test-launcher/launcher.test.js",
    "conformance": "tsc -b packages/runtime && node packages/runtime/dist/src/node/cli.js conformance",
    "bridge": "tsc -b packages/runtime && node packages/runtime/dist/src/node/cli.js bridge",
    "build:example-pod": "tsc -b && node packages/runtime/dist/src/node/cli.js build-example-pod",
    "kit:bridge": "tsc -b && node packages/runtime/dist/src/node/cli.js kit-bridge",
    "build:example-site": "tsc -b && node packages/site/dist/src/node/cli.js build-example-site",
    "build:example": "tsc -b && node packages/site/dist/src/node/cli.js build-example",
    "build:pages": "tsc -b && node packages/site/dist/src/node/cli.js build-pages",
    "build:spec": "tsc -b && node packages/site/dist/src/node/cli.js build-spec",
    "build:package": "tsc -b && node packages/cascade-runtime/dist/pack/pack.js",
    "serve:pages": "tsc -b && node packages/site/dist/src/node/cli.js serve-pages",
    "ask": "tsc -b && node packages/site/dist/src/node/cli.js ask",
    "graphdb": "tsc -b && node packages/graphdb/dist/src/node/cli.js",
    "story:pulls": "tsc -b && node packages/cascade-runtime/dist/test/story-pulls.js",
    "evals": "tsc -b packages/evals && node packages/evals/dist/src/cli.js",
    "evals:record": "tsc -b packages/evals && node packages/evals/dist/src/cli.js record-history",
    "evals:report": "tsc -b packages/evals && node packages/evals/dist/src/cli.js report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "cascade-reference-tables": "https://github.com/jayostis/cascade-reference-tables/releases/download/package-builds/cascade-reference-tables-0.0.0-commit-abcb8bd9a99f3f2d9b33351b97416fc0b81f7bab.tgz",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
